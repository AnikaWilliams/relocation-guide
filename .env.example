# Production site URL — used for canonical URLs and sitemap generation.
# Copy this file to `.env` and set the real domain before launch.
SITE_URL=https://relocation-guide.example

# --- Analytics & advertising (ADR-0004) ----------------------------------
# All optional. Leave EMPTY to keep the feature dormant: with no value set,
# the script never loads — not even after a visitor clicks "Accept". Populate
# at launch, once the domain and provider accounts exist. Must be PUBLIC_*
# (client-side islands can only read PUBLIC_-prefixed vars).

# Cookieless, privacy-friendly analytics. No consent prompt required.
# e.g. PUBLIC_PLAUSIBLE_DOMAIN=relocation-guide.example
PUBLIC_PLAUSIBLE_DOMAIN=

# Google Analytics 4 — consent-gated (loads only with analytics consent).
# e.g. PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google AdSense — consent-gated, post-launch (loads only with advertising consent).
# e.g. PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_CLIENT=

# --- Launch waitlist (not-yet-live corridors) -----------------------------
# POST endpoint that stores a waitlist signup and can email/SMS it when the
# route launches. Leave EMPTY to keep the waitlist DORMANT: signups are kept in
# the visitor's own browser only and NOTHING is transmitted off-device (so the
# privacy policy's "your answers stay in your browser" stays true). Before you
# set this: update + lawyer-review the Privacy/Cookie policies and agree a
# data-processing agreement with the backend that receives the signup.
# e.g. PUBLIC_WAITLIST_ENDPOINT=https://api.relocation-guide.example/waitlist
PUBLIC_WAITLIST_ENDPOINT=
