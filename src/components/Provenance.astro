---
import type { Claim } from '../content/schema';

/**
 * Visible provenance (CLAUDE.md rule 6): every page shows its sources and the
 * last-verified date to users. Pass the rendered claims; this dedupes their
 * official sources and surfaces the most recent verification date.
 */
interface Props {
  claims: Claim[];
  lastReviewed?: string;
}

const { claims, lastReviewed } = Astro.props;

// Dedupe sources by URL, keeping a human-readable name.
const sourceMap = new Map<string, string>();
for (const c of claims) {
  if (c.sourceUrl) sourceMap.set(c.sourceUrl, c.sourceName || c.sourceUrl);
}
const sources = [...sourceMap.entries()].map(([url, name]) => ({ url, name }));

// Most recent lastVerified across rendered claims.
const verifiedDates = claims
  .map((c) => c.lastVerified)
  .filter((d): d is string => Boolean(d))
  .sort();
const mostRecentVerified = verifiedDates.at(-1);
---

<section
  aria-label="Sources and verification"
  class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm"
>
  <h2 class="font-semibold text-slate-900">Sources &amp; verification</h2>
  <dl class="mt-2 space-y-1 text-slate-600">
    {
      mostRecentVerified && (
        <div class="flex gap-2">
          <dt class="font-medium">Last verified:</dt>
          <dd>
            <time datetime={mostRecentVerified}>{mostRecentVerified}</time>
          </dd>
        </div>
      )
    }
    {
      lastReviewed && (
        <div class="flex gap-2">
          <dt class="font-medium">Corridor last reviewed:</dt>
          <dd>
            <time datetime={lastReviewed}>{lastReviewed}</time>
          </dd>
        </div>
      )
    }
  </dl>

  {
    sources.length > 0 && (
      <>
        <h3 class="mt-3 font-medium text-slate-900">Official sources</h3>
        <ul class="mt-1 list-disc pl-5 space-y-1">
          {sources.map((s) => (
            <li>
              <a
                href={s.url}
                rel="nofollow noopener external"
                target="_blank"
                class="text-blue-700 underline underline-offset-2 hover:text-blue-900"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
