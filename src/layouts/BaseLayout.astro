---
import '../styles/global.css';
import Disclaimer from '../components/Disclaimer.astro';

interface Props {
  title: string;
  description: string;
  /** Remove all padding and hide the footer — for full-bleed app-style pages. */
  fullBleed?: boolean;
}

const { title, description, fullBleed = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Relocation Guide" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    {/* Per-page head extras (e.g. JSON-LD structured data) */}
    <slot name="head" />
  </head>
  <body
    class:list={[
      'bg-white text-slate-900 antialiased flex flex-col',
      // App-style pages are exactly viewport height so inner panels can pin
      // headers/footers and scroll internally; content pages grow naturally.
      fullBleed ? 'h-screen overflow-hidden' : 'min-h-screen',
    ]}
  >
    {!fullBleed && (
      <header class="border-b border-slate-200">
        <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
          <a href="/" class="font-semibold text-lg">Relocation Guide</a>
          <nav class="text-sm text-slate-600">
            <a href="/" class="hover:text-slate-900">Corridors</a>
          </nav>
        </div>
      </header>
    )}

    <main class={fullBleed ? 'flex-1 flex flex-col overflow-hidden' : 'mx-auto w-full max-w-5xl flex-1 px-4 py-8'}>
      <slot />
    </main>

    {!fullBleed && (
      <footer class="border-t border-slate-200 mt-12">
        <div class="mx-auto max-w-5xl px-4 py-8 space-y-4 text-sm text-slate-600">
          <Disclaimer />
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p>&copy; {new Date().getFullYear()} Relocation Guide. Informational use only.</p>
            <nav aria-label="Legal" class="flex gap-4">
              <a href="/impressum" class="hover:text-slate-900 underline">Impressum</a>
            </nav>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
