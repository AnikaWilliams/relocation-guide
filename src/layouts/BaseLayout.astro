---
import '../styles/global.css';
import Disclaimer from '../components/Disclaimer.astro';
import ConsentBanner from '../components/ConsentBanner.tsx';

interface Props {
  title: string;
  description: string;
  /** Remove all padding and hide the footer — for full-bleed app-style pages. */
  fullBleed?: boolean;
  /** Social-card image path (site-absolute, e.g. "/og/foo.png"). Defaults to the
      branded default card. PNG is used because some scrapers reject SVG. */
  ogImage?: string;
}

const { title, description, fullBleed = false, ogImage = '/og/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Scrapers require an absolute og:image URL.
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Relocation Guide" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    {/* Per-page head extras (e.g. JSON-LD structured data) */}
    <slot name="head" />
  </head>
  <!-- fullBleed pages scroll like any document (ADR-0011: the app is a
       viewport-height hero section; the indexable guide flows below it).
       The app's height constraint lives on its wrapper in the page, not here. -->
  <body class="min-h-screen bg-white text-slate-900 antialiased flex flex-col">
    {!fullBleed && (
      <header class="border-b border-slate-200">
        <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
          <a href="/" class="font-semibold text-lg">Relocation Guide</a>
          <nav class="text-sm text-slate-600">
            <a href="/" class="hover:text-slate-900">Corridors</a>
          </nav>
        </div>
      </header>
    )}

    <main class={fullBleed ? 'w-full flex-1' : 'mx-auto w-full max-w-5xl flex-1 px-4 py-8'}>
      <slot />
    </main>

    {/* Footer renders on every page, including fullBleed corridor pages —
        the Impressum must be reachable from everywhere (compliance review,
        2026-06-12). */}
    <footer class={`border-t border-slate-200 ${fullBleed ? '' : 'mt-12'}`}>
        <div class="mx-auto max-w-5xl px-4 py-8 space-y-4 text-sm text-slate-600">
          <Disclaimer />
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
            <p>&copy; {new Date().getFullYear()} Relocation Guide. Informational use only.</p>
            <nav aria-label="Site and legal" class="flex flex-wrap gap-x-4 gap-y-1">
              <a href="/about" class="hover:text-slate-900 underline">About</a>
              <a href="/contact" class="hover:text-slate-900 underline">Contact</a>
              <a href="/privacy" class="hover:text-slate-900 underline">Privacy</a>
              <a href="/cookie-policy" class="hover:text-slate-900 underline">Cookies</a>
              <a href="/terms" class="hover:text-slate-900 underline">Terms</a>
              <a href="/impressum" class="hover:text-slate-900 underline">Impressum</a>
              <button type="button" data-cookie-settings class="hover:text-slate-900 underline">
                Cookie settings
              </button>
            </nav>
          </div>
        </div>
      </footer>

      <ConsentBanner client:load />

      {/* Footer "Cookie settings" re-opens the consent panel (handled by the
          ConsentBanner island via a window event). */}
      <script>
        import { CONSENT_OPEN_EVENT } from '../utils/analytics';
        document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
          el.addEventListener('click', () => window.dispatchEvent(new Event(CONSENT_OPEN_EVENT)));
        });
      </script>
  </body>
</html>
