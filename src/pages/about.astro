---
/**
 * About page — explains the product using the project's own framing.
 * Facts are sourced from README.md / CLAUDE.md (corridor model, source-verified
 * claims, two-reviewer rule, build gate, "informational only"). No invented claims.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const linkClass =
  'text-link underline hover:text-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded';
---

<BaseLayout
  title="About — Relocation Guide"
  description="Relocation Guide gives source-backed, independently verified relocation guidance organised by origin and destination country."
>
  <article class="mx-auto max-w-[680px] space-y-12">
    <section class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-label">
        About Relocation Guide
      </h1>
      <p class="text-lg leading-relaxed text-secondaryLabel">
        Moving to another country means making legal, financial, and life-altering
        decisions from scattered, fast-changing information. Relocation Guide brings the
        steps for your specific move into one place &mdash; and shows you exactly where
        each fact comes from.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-label">Guidance by corridor</h2>
      <p class="leading-relaxed text-secondaryLabel">
        Our content is organised by <strong class="font-semibold text-label">corridor</strong>
        &mdash; your origin country paired with your destination country &mdash; because the
        rules that apply to you depend on both. You tell the planner where you are moving from
        and to, why you are moving, and a few details about your situation; it then shows the
        steps that apply to <em>you</em>, in order, with the documents you will need for each one.
      </p>
      <p class="leading-relaxed text-secondaryLabel">
        Our first corridor is
        <strong class="font-semibold text-label">USA &rarr; Switzerland</strong>, covering the
        work, family-reunification, retirement, and study routes. More corridors are in
        preparation and will appear once they pass the same checks.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-label">How we keep it accurate</h2>
      <p class="leading-relaxed text-secondaryLabel">
        Accuracy is the whole point, so we built the site around it:
      </p>
      <ul class="list-disc space-y-2 pl-6 leading-relaxed text-secondaryLabel">
        <li>
          <strong class="font-semibold text-label">Every claim has an official source.</strong>
          Each fact is traced to a primary, official authority &mdash; not a blog or a forum.
        </li>
        <li>
          <strong class="font-semibold text-label">Two independent checks.</strong> The person
          who writes a claim and the person who verifies it are never the same. A claim is only
          published after a separate reviewer confirms it against the source.
        </li>
        <li>
          <strong class="font-semibold text-label">Dated and shown to you.</strong> Each page
          displays its sources and the date the facts were last verified, so you can judge how
          current they are.
        </li>
        <li>
          <strong class="font-semibold text-label">Stale facts can't slip through.</strong> Our
          publishing process refuses to release a page if any claim on it is unverified or
          overdue for re-checking.
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-label">Your answers stay with you</h2>
      <p class="leading-relaxed text-secondaryLabel">
        The planner runs in your browser. The answers you give are saved on your own
        device, not on our servers, and there are no accounts to create. You can clear
        everything at any time. See our <a href="/privacy" class={linkClass}>Privacy policy</a>
        for details.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-label">What we are not</h2>
      <p class="leading-relaxed text-secondaryLabel">
        Relocation Guide is <strong class="font-semibold text-label">information, not advice</strong>.
        We are not a law firm and not licensed immigration advisers, and using the site does not
        create an advisory relationship. Immigration rules change often, so always confirm your
        situation with the official authority or a licensed adviser before acting.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold tracking-tight text-label">Get in touch</h2>
      <p class="leading-relaxed text-secondaryLabel">
        Spotted something out of date, or have a question? See our
        <a href="/contact" class={linkClass}>Contact page</a>. Operator details are in our
        <a href="/impressum" class={linkClass}>Impressum</a>.
      </p>
    </section>
  </article>
</BaseLayout>
