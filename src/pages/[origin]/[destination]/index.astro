---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Provenance from '../../../components/Provenance.astro';
import CorridorFlowchart from '../../../components/CorridorFlowchart.tsx';
import { getPublishedCorridors, countryName } from '../../../utils/corridors';
import { collectClaims } from '../../../utils/provenance';
import type { Claim } from '../../../content/schema';

export const getStaticPaths = (async () => {
  // getPublishedCorridors applies the provenance gate — a published corridor
  // with an unrenderable claim throws here and fails the build (Phase 3 rule 5).
  const corridors = await getPublishedCorridors();
  return corridors.map((entry) => ({
    params: { origin: entry.data.originIso2, destination: entry.data.destinationIso2 },
    props: { corridor: entry.data },
  }));
}) satisfies GetStaticPaths;

const { corridor } = Astro.props;
const allClaims: Claim[] = collectClaims(corridor).map((c) => c.claim);
const flowTasks = corridor.tasks.map((t) => ({
  id: t.id,
  title: t.title,
  category: t.category,
  dependsOn: t.dependsOn,
}));
---

<BaseLayout title={corridor.title} description={corridor.description}>
  <article class="space-y-8">
    <header class="space-y-2">
      <p class="text-sm uppercase tracking-wide text-slate-500">
        {countryName(corridor.originIso2)} &rarr; {countryName(corridor.destinationIso2)}
      </p>
      <h1 class="text-3xl font-bold">{corridor.title}</h1>
      <p class="max-w-2xl text-slate-600">{corridor.description}</p>
    </header>

    <section aria-label="Relocation steps overview">
      <h2 class="text-xl font-semibold mb-3">How the steps fit together</h2>
      <CorridorFlowchart tasks={flowTasks} client:visible />
    </section>

    <section class="space-y-6">
      <h2 class="text-xl font-semibold">Steps</h2>
      {
        corridor.tasks.map((task) => (
          <div class="rounded-lg border border-slate-200 p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-lg font-semibold">{task.title}</h3>
              <span class="text-xs rounded bg-slate-100 px-2 py-0.5 text-slate-600">
                {task.category}
              </span>
            </div>
            <p class="mt-2 text-slate-700">{task.summary.text}</p>
            {task.detail && <p class="mt-2 text-sm text-slate-600">{task.detail}</p>}
            <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-medium text-slate-900">Timeline</dt>
                <dd class="text-slate-600">{task.timeline.text}</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-900">Cost</dt>
                <dd class="text-slate-600">{task.cost.text}</dd>
              </div>
            </dl>
            {task.warning && (
              <p class="mt-3 rounded border border-red-200 bg-red-50 p-2 text-sm text-red-800">
                {task.warning}
              </p>
            )}
          </div>
        ))
      }
    </section>

    <Provenance claims={allClaims} lastReviewed={corridor.lastReviewed} />
  </article>
</BaseLayout>
