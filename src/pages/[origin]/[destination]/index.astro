---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CorridorApp, { type TaskData } from '../../../components/CorridorApp.tsx';
import { getPublishedCorridors, countryName } from '../../../utils/corridors';

export const getStaticPaths = (async () => {
  const corridors = await getPublishedCorridors();
  return corridors.map((entry) => ({
    params: { origin: entry.data.originIso2, destination: entry.data.destinationIso2 },
    props: { corridor: entry.data },
  }));
}) satisfies GetStaticPaths;

const { corridor } = Astro.props;

const appTasks: TaskData[] = corridor.tasks.map((t) => ({
  id: t.id,
  title: t.title,
  category: t.category,
  summary: { text: t.summary.text, sourceUrl: t.summary.sourceUrl, sourceName: t.summary.sourceName },
  detail: t.detail,
  steps: t.steps.map((s) => ({
    text: s.text,
    tip: s.tip,
    links: s.links?.map((l) => ({ text: l.text, sourceUrl: l.sourceUrl, sourceName: l.sourceName })),
  })),
  documents: t.documents,
  timeline: t.timeline ? { text: t.timeline.text, sourceUrl: t.timeline.sourceUrl, sourceName: t.timeline.sourceName } : undefined,
  cost: t.cost ? { text: t.cost.text, sourceUrl: t.cost.sourceUrl, sourceName: t.cost.sourceName } : undefined,
  warning: t.warning,
  dependsOn: t.dependsOn,
  appliesIf: t.appliesIf,
}));

const originName = countryName(corridor.originIso2);
const destinationName = countryName(corridor.destinationIso2);
---

<BaseLayout title={corridor.title} description={corridor.description} fullBleed>
  <CorridorApp
    tasks={appTasks}
    corridorTitle={corridor.title}
    originName={originName}
    destinationName={destinationName}
    client:load
  />
</BaseLayout>
