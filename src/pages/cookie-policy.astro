---
/**
 * Cookie & local-storage policy — DRAFT (compliance scope, CLAUDE.md).
 *
 * Status: DRAFT — placeholders in [BRACKETS] must be completed by the operator
 * and the whole page MUST be reviewed by a qualified lawyer before launch
 * (CLAUDE.md: cookie policy is draft-only until human lawyer review). Do NOT
 * remove the draft banner until lawyer sign-off is recorded in DECISIONS.md.
 *
 * Inventory below reflects ACTUAL + PLANNED storage:
 * - relocation-intake-v2 (localStorage): planner answers + progress. Strictly
 *   necessary; no consent needed. Set TODAY.
 * - rg-consent-v1 (localStorage): the visitor's own consent choices. Strictly
 *   necessary; no consent needed. Set when the banner ships.
 * - rg-waitlist-v1 (localStorage): launch-waitlist signups the visitor made for
 *   not-yet-live routes. Set only when the visitor submits the waitlist form.
 *   Dormant by default — nothing is transmitted off-device unless
 *   PUBLIC_WAITLIST_ENDPOINT is configured (then email/phone are sent with the
 *   visitor's explicit consent).
 * - Plausible (cookieless analytics): no storage, no consent. PLANNED at launch.
 * - GA4 (_ga / _ga_*): analytics cookies, CONSENT REQUIRED. PLANNED at launch.
 * - AdSense (advertising cookies): CONSENT REQUIRED. PLANNED post-launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

interface StorageRow {
  name: string;
  type: string;
  purpose: string;
  lifetime: string;
  consent: string;
  status: string;
}

const inventory: StorageRow[] = [
  {
    name: 'relocation-intake-v2',
    type: 'Local storage',
    purpose: 'Remembers your planner answers and checklist progress on your device.',
    lifetime: 'Until you clear it ("Start over" or browser settings)',
    consent: 'Not required (strictly necessary)',
    status: 'Active',
  },
  {
    name: 'rg-consent-v1',
    type: 'Local storage',
    purpose: 'Remembers your own cookie/analytics choices so we do not ask again.',
    lifetime: 'Until you clear it or change your choice',
    consent: 'Not required (strictly necessary)',
    status: 'Active when the banner ships',
  },
  {
    name: 'rg-waitlist-v1',
    type: 'Local storage',
    purpose:
      'If you ask to be notified about a route that is not live yet, remembers that request (and the email/phone you gave) on your device, so we can confirm it and not ask twice.',
    lifetime: 'Until you clear it',
    consent: 'You actively submit the form; off-device sending needs your explicit consent',
    status: 'Set only if you use the launch-waitlist form',
  },
  {
    name: 'Plausible Analytics',
    type: 'No cookie / no storage',
    purpose: 'Privacy-friendly, aggregate visitor measurement. Sets no cookies, collects no personal data.',
    lifetime: 'n/a',
    consent: 'Not required (cookieless, no personal data)',
    status: 'Planned at launch',
  },
  {
    name: '_ga, _ga_*',
    type: 'Cookie (Google Analytics 4)',
    purpose: 'Distinguishes visitors and sessions for usage statistics. Loads only with consent.',
    lifetime: 'Up to ~13 months [confirm]',
    consent: 'Required (Analytics)',
    status: 'Planned at launch',
  },
  {
    name: 'Google AdSense cookies',
    type: 'Cookie (advertising)',
    purpose: 'Serves and frequency-caps ads; supports personalised advertising. Loads only with consent.',
    lifetime: 'Varies by cookie [confirm]',
    consent: 'Required (Advertising)',
    status: 'Planned post-launch',
  },
];
---

<BaseLayout
  title="Cookie & storage policy — Relocation Guide"
  description="What this site stores in your browser and which technologies require your consent."
>
  <div class="mx-auto max-w-3xl">
    <!-- DRAFT banner — remove only after human lawyer sign-off -->
    <aside
      role="note"
      aria-label="Draft status"
      class="rounded-field border border-warning-border bg-warning-soft p-4 text-sm text-warning"
    >
      <p>
        <strong class="font-semibold">DRAFT — not yet in force.</strong> This policy contains
        placeholder values in [BRACKETS] and has not been reviewed by a lawyer. Lifetimes and
        cookie names for third-party tools must be confirmed against the providers' own
        documentation before launch.
      </p>
    </aside>

    <article class="mt-10 space-y-12">
      <section class="max-w-[680px] space-y-4">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-label">
          Cookie &amp; storage policy
        </h1>
        <p class="text-lg leading-relaxed text-secondaryLabel">
          This page lists everything Relocation Guide stores in your browser and explains
          which items need your consent. See also our
          <a
            href="/privacy"
            class="text-link underline hover:text-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
            >Privacy policy</a
          >.
        </p>
      </section>

      <section class="max-w-[680px] space-y-3">
        <h2 class="text-xl font-semibold tracking-tight text-label">Two kinds of storage</h2>
        <p class="leading-relaxed text-secondaryLabel">
          <strong class="font-semibold text-label">Strictly necessary</strong> storage makes the
          site work &mdash; it remembers your planner answers and your cookie choices, on your
          device only. It needs no consent.
          <strong class="font-semibold text-label">Optional</strong> technologies (analytics that
          use cookies, and advertising) load
          <strong class="font-semibold text-label">only after you agree</strong> in the cookie
          banner, and you can change your mind at any time.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="max-w-[680px] text-xl font-semibold tracking-tight text-label">What we store</h2>
        <div class="overflow-x-auto rounded-card border border-separator">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-separator bg-surface align-bottom">
                <th class="px-4 py-3 font-semibold text-label">Name</th>
                <th class="px-4 py-3 font-semibold text-label">Type</th>
                <th class="px-4 py-3 font-semibold text-label">Purpose</th>
                <th class="px-4 py-3 font-semibold text-label">Lifetime</th>
                <th class="px-4 py-3 font-semibold text-label">Consent</th>
                <th class="px-4 py-3 font-semibold text-label">Status</th>
              </tr>
            </thead>
            <tbody>
              {inventory.map((row) => (
                <tr class="border-b border-separator align-top last:border-b-0">
                  <td class="px-4 py-3"><code class="rounded bg-surface px-1.5 py-0.5 text-xs text-label">{row.name}</code></td>
                  <td class="px-4 py-3 text-secondaryLabel">{row.type}</td>
                  <td class="px-4 py-3 text-secondaryLabel">{row.purpose}</td>
                  <td class="px-4 py-3 text-secondaryLabel">{row.lifetime}</td>
                  <td class="px-4 py-3 text-secondaryLabel">{row.consent}</td>
                  <td class="px-4 py-3 text-secondaryLabel">{row.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="max-w-[680px] space-y-3">
        <h2 class="text-xl font-semibold tracking-tight text-label">Managing your choices</h2>
        <ul class="list-disc space-y-2 pl-6 leading-relaxed text-secondaryLabel">
          <li>
            Use the <strong class="font-semibold text-label">cookie settings</strong> link in the
            footer to accept or reject optional categories, or to change a previous choice.
          </li>
          <li>
            Use the planner's <strong class="font-semibold text-label">"Start over"</strong>
            control to clear your saved answers and progress.
          </li>
          <li>
            You can also clear all of this site's storage through your browser's privacy
            settings.
          </li>
        </ul>
        <p class="leading-relaxed text-secondaryLabel">
          Blocking strictly-necessary storage may stop the planner from remembering your
          progress, but you can still read every step.
        </p>
      </section>

      <p class="max-w-[680px] text-sm text-tertiaryLabel">
        Last updated: [DATE — set when placeholders are filled in]. Draft pending human
        lawyer review.
      </p>
    </article>
  </div>
</BaseLayout>
